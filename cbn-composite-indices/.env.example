# Copy this file to .env for local Docker Compose configuration.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
WEB_PORT=8000

POSTGRES_DB=indices
POSTGRES_USER=indices
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Celery/Flask Redis connections. Inside Compose, use the Redis service name.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Maximum uploaded file size in bytes (50 MiB by default).
MAX_CONTENT_LENGTH=52428800

# Read-only mount for QA sample datasets inside the containers.
# deploy.sh sets this to /var/www/cbn-reference.
REFERENCE_DIR=../
